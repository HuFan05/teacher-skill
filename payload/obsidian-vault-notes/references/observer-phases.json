{
  "schema_version": 1,
  "catalog_version": "obsidian-vault-notes/v1",
  "metric_contract": "timing/v1",
  "workflow_phases": [
    "workflow.startup",
    "retrieve",
    "verify_live",
    "plan_change",
    "mutate",
    "validate",
    "version_control",
    "final_response"
  ],
  "script_phases": [
    "obsidian.retrieval.validate",
    "obsidian.retrieval.index.status",
    "obsidian.retrieval.index.refresh.enumerate",
    "obsidian.retrieval.index.refresh.classify",
    "obsidian.retrieval.index.refresh.parse",
    "obsidian.retrieval.index.refresh.commit",
    "obsidian.retrieval.query",
    "obsidian.retrieval.note.resolve",
    "obsidian.retrieval.note.live_read",
    "obsidian.retrieval.note.link_metadata",
    "obsidian.retrieval.result.build",
    "obsidian.retrieval.result.build.candidates",
    "obsidian.edit.snapshot",
    "obsidian.edit.transform",
    "obsidian.edit.resource.preflight.scan_compare",
    "obsidian.edit.resource.preflight.harness_preview",
    "obsidian.edit.resource.preflight.resolve_ids",
    "obsidian.edit.atomic_write",
    "obsidian.edit.verify",
    "obsidian.edit.resource.sync.dry_run",
    "obsidian.edit.resource.sync.write",
    "obsidian.impact.enumerate",
    "obsidian.impact.build_index",
    "obsidian.impact.scan",
    "obsidian.batch.manifest",
    "obsidian.batch.preflight",
    "obsidian.batch.assertions",
    "obsidian.batch.prepare",
    "obsidian.batch.write",
    "obsidian.batch.resource.sync",
    "obsidian.batch.rollback",
    "obsidian.lint.acquire_scope",
    "obsidian.lint.scan",
    "obsidian.lint.semantic_sentinels",
    "obsidian.git.precheck",
    "obsidian.git.diff",
    "obsidian.git.diff_check",
    "obsidian.stats.enumerate",
    "obsidian.stats.scan",
    "obsidian.stats.index_status",
    "obsidian-vault-notes.script.run"
  ],
  "allowed_fields": {
    "mode": "name",
    "operation": "name",
    "write": "boolean",
    "file_count": "nonnegative_integer",
    "candidate_count": "nonnegative_integer",
    "byte_count": "nonnegative_integer",
    "harness_call_count": "nonnegative_integer",
    "result_count": "nonnegative_integer",
    "change_count": "nonnegative_integer",
    "warning_count": "nonnegative_integer",
    "error_count": "nonnegative_integer"
  },
  "forbidden_data": [
    "path",
    "title",
    "note_title",
    "query",
    "body",
    "excerpt",
    "heading",
    "diff",
    "command",
    "exception_text",
    "resource_id",
    "raw_file_hash",
    "tool_output"
  ]
}
